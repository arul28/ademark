---
// The bench mark with its pink bar, and the Geist wordmark.
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---
<a href="/" class="logo" aria-label="ADEMark home">
  <svg class="mark-logo" viewBox="0 0 92 86" width={size} height={Math.round((size * 86) / 92)} aria-hidden="true">
    <rect x="0" y="0" width="92" height="12" fill="var(--color-signal)" />
    <polygon points="46,20 88,86 74,86 46,42 18,86 4,86" fill="var(--color-text)" />
    <rect x="40" y="32" width="12" height="54" fill="var(--color-text)" />
  </svg>
  <span class="word">ADEMark</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .mark-logo {
    flex-shrink: 0;
  }
  .word {
    font: 700 22px/28px var(--font-wordmark);
    letter-spacing: -0.05em;
  }
</style>
